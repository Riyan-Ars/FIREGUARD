# FIREGUARD Backend Environment Configuration Example
# Copy this file to .env and configure values for your environment.

# Server Configuration
PORT=3000
NODE_ENV=development
API_PREFIX=/api/v1

# CORS Configuration (comma-separated origins or * for development)
ALLOWED_ORIGINS=*

# NASA FIRMS API (Get your free MAP_KEY at https://firms.modaps.eosdis.nasa.gov/api/map_key)
# When empty or DEMO_KEY, the backend automatically uses verified regional snapshot datasets.
NASA_FIRMS_MAP_KEY=YOUR_NASA_FIRMS_MAP_KEY_HERE

# Cache TTL Configuration (in seconds)
HOTSPOT_CACHE_TTL_SECONDS=300
AIR_QUALITY_CACHE_TTL_SECONDS=600

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
